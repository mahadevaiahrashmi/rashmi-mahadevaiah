# Example env file — safe to commit. Copy to .env and fill in real values.
# .env is gitignored; .env.example is not. On Vercel these are set as
# Project → Settings → Environment Variables (not from this file).
#
#   cp .env.example .env    then fill in what you need.
#
# Nothing here is strictly required to boot the site — every AI app degrades
# gracefully without its key (Learn-AI needs no keys at all). Add only what you
# want to use.

# ── Which LLM powers the AI apps? ───────────────────────────────────────────
# The text apps (Resume Tailor, Personal Voice, Funded Agent, GTM plan, PM Agent)
# run on ANY ONE of the four providers below. Set a key for the one you want.
# LLM_PROVIDER forces a choice; if unset, the first key present wins, in this
# order: openrouter, anthropic, openai, gemini.
#   LLM_PROVIDER = openrouter | openai | anthropic | gemini
# LLM_PROVIDER=openrouter

# OpenRouter — one key, many models (also the only provider with live web search
# used by the Funded Companies Agent). Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODELS=deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct:free

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini (Google) — also works for text on the FREE tier (no billing needed).
# The same GEMINI_API_KEY below powers Veo video (which DOES need billing).
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# ── Google Gemini / Veo — real video generation in the GTM app (optional) ───
# Needs a BILLING-ENABLED key; Veo is paid (~$1-6 per 8s clip).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_or_AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: which Veo model to use (must be available to your key).
# GEMINI_VEO_MODEL=veo-3.1-fast-generate-preview
# Optional: passcode gate so only you can trigger paid Veo generation.
VEO_PASSCODE=choose-a-passcode

# ── PostHog — product analytics for the Learn-AI app (optional) ─────────────
# Project API key (public, safe in the browser). PostHog -> Settings ->
# Project -> Project API Key.  Host: US = https://us.i.posthog.com, EU = https://eu.i.posthog.com
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com
